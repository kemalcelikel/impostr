# Local development only. Set unique random hex passwords before starting Compose.
# Do not reuse shared-server credentials. Keep the generated .env file untracked.
POSTGRES_DB=impostr
POSTGRES_USER=impostr_owner
POSTGRES_PASSWORD=
DB_USER=impostr_app
DB_PASSWORD=

# Optional separate key for pseudonymized persisted rate-limit buckets; if blank,
# the API uses DB_PASSWORD as the per-stack HMAC key.
IMPOSTR_RATE_LIMIT_KEY=

# Leave IMPOSTR_PUBLIC_ORIGIN unset to derive the local origin from APP_PORT.
# This checkout is loopback-only. Reverse-proxy client-IP trust is a release gate;
# do not expose this stack through an external proxy until that contract is tested.
IMPOSTR_PUBLIC_ORIGIN=
APP_PORT=8080
