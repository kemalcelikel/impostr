# Local development only. Set unique random hex passwords before starting Compose.
# Do not reuse shared-server credentials. Keep the generated .env file untracked.
POSTGRES_DB=impostr
POSTGRES_USER=impostr_owner
POSTGRES_PASSWORD=
DB_USER=impostr_app
DB_PASSWORD=

# The development front door is loopback-only by default; no TLS/domain is implied.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
