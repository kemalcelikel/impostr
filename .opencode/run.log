+def test_normal_api_denies_nonplanning_mode_and_keeps_history(chat_setup, mode):
+    client, engine, _, _, base, conv, broker, dispatcher = chat_setup
+    request_id = uuid.uuid4()
+    turn = submit(chat_setup, request_id).json()["id"]
+    broker.mode = mode
