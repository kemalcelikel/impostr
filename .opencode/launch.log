+def _duplicate_name(db: Session, owner_user_id: uuid.UUID, name_key: str) -> bool:
+    return (
+        db.scalar(
+            select(Project.id)
+            .where(Project.owner_user_id == owner_user_id, Project.name_key == name_key)
