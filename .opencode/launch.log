+    store = cast(WorkspaceStore, request.app.state.workspace_store)
+    try:
+        for kind, template in templates.items():
+            store.write_document(project.id, kind, template.content)
+    except WorkspaceError as exc:
+        db.rollback()
+        raise HTTPException(
+            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
+            detail=(
+                "Project templates or the private workspace are unavailable; no project was saved."
+            ),
+        ) from exc
+
+    if current_actor.role == "admin":
+        record_audit(
+            db,
+            action="admin.project.create",
+            actor_user_id=current_actor.id,
+            project_id=project.id,
+            details={"document_kinds": ["project", "agents", "backlog"]},
+        )
+    db.commit()
+    return project_view(project)
+
+
